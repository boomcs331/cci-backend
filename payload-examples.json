{
  "receiving_examples": {
    "example_1_full": {
      "description": "รับเหล็กแผ่น 1,000 kg พร้อมข้อมูลครบถ้วน",
      "endpoint": "POST /materials/transactions/receive",
      "payload": {
        "materialId": 1,
        "totalQuantity": 1000,
        "supplierId": 1,
        "poNo": "PO-2024-001",
        "locationId": 1,
        "remark": "รับเหล็กแผ่นจากซัพพลายเออร์ ABC Steel",
        "createBy": "admin"
      }
    },
    "example_2_with_expiry": {
      "description": "รับพลาสติก 500 kg พร้อมวันหมดอายุ",
      "endpoint": "POST /materials/transactions/receive",
      "payload": {
        "materialId": 2,
        "totalQuantity": 500,
        "supplierId": 3,
        "poNo": "PO-2024-002",
        "locationId": 2,
        "expiryDate": "2025-12-31",
        "remark": "รับพลาสติกชนิดพิเศษ",
        "createBy": "admin"
      }
    },
    "example_3_minimal": {
      "description": "รับแบบขั้นต่ำ (Required fields only)",
      "endpoint": "POST /materials/transactions/receive",
      "payload": {
        "materialId": 1,
        "totalQuantity": 250
      }
    },
    "example_4_chemical": {
      "description": "รับสารเคมี 237 kg",
      "endpoint": "POST /materials/transactions/receive",
      "payload": {
        "materialId": 4,
        "totalQuantity": 237,
        "supplierId": 4,
        "poNo": "PO-2024-003",
        "locationId": 3,
        "expiryDate": "2024-12-31",
        "remark": "สารเคมีต้องเก็บในที่เย็น",
        "createBy": "admin"
      }
    }
  },
  "issuing_examples": {
    "example_1_full": {
      "description": "จ่ายให้แผนกผลิต 250 kg",
      "endpoint": "POST /materials/transactions/issue",
      "payload": {
        "materialId": 1,
        "quantity": 250,
        "department": "Production",
        "workOrderNo": "WO-2024-001",
        "remark": "เบิกเหล็กแผ่นสำหรับผลิตชิ้นงาน A",
        "createBy": "admin"
      }
    },
    "example_2_assembly": {
      "description": "จ่ายให้แผนกประกอบ 75 kg",
      "endpoint": "POST /materials/transactions/issue",
      "payload": {
        "materialId": 2,
        "quantity": 75,
        "department": "Assembly",
        "workOrderNo": "WO-2024-002",
        "remark": "เบิกพลาสติกสำหรับประกอบ",
        "createBy": "admin"
      }
    },
    "example_3_minimal": {
      "description": "จ่ายแบบขั้นต่ำ (Required fields only)",
      "endpoint": "POST /materials/transactions/issue",
      "payload": {
        "materialId": 1,
        "quantity": 100
      }
    },
    "example_4_maintenance": {
      "description": "จ่ายให้แผนกซ่อมบำรุง",
      "endpoint": "POST /materials/transactions/issue",
      "payload": {
        "materialId": 3,
        "quantity": 50,
        "department": "Maintenance",
        "remark": "เบิกอะไหล่สำหรับซ่อมเครื่องจักร",
        "createBy": "admin"
      }
    }
  },
